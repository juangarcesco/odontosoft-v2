router.get('/paciente/:pacienteId', verificarToken, permitirRoles('ADMIN', 'ODONTOLOGO'), obtenerPorPaciente);

// RN-03: solo ODONTOLOGO edita contenido clínico
router.patch(
  '/paciente/:pacienteId/odontograma/:numeroDiente',
