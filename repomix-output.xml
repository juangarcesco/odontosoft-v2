  permitirRoles('ODONTOLOGO'),
  actualizarOdontograma
);

// RN-03: solo ODONTOLOGO crea evoluciones; RN-09: se registra automáticamente quién y cuándo
router.post(
  '/paciente/:pacienteId/evoluciones',
  verificarToken,
  permitirRoles('ODONTOLOGO'),
  crearEvolucion
);

router.patch(
  '/paciente/:pacienteId/antecedentes',
  verificarToken,
  permitirRoles('ODONTOLOGO'),
