    <h2>1. Selecciona el periodo a validar</h2>
    <div class="fila-selector">
      <input
        type="month"
        [ngModel]="periodo()"
        (ngModelChange)="periodo.set($event)"
      />
      <button class="btn-primario" [disabled]="validando()" (click)="validar()">
        {{ validando() ? 'Validando...' : 'Validar periodo' }}
      </button>
